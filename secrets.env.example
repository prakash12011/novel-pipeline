# Copy to ~/.novel-pipeline/secrets.env (or $NOVEL_HOME/secrets.env) and fill in. Never commit the real file.
# KEY=VALUE lines, no spaces around "=". Only this file is read; a .env in the repo is ignored.

# --- Gemini (novel write / prompt / qa) -------------------------------------------------------
# Any variable starting with GEMINI_API_KEY is used. The one containing HYDROGEN is tried first
# (the key for gemini-4-hydrogen); the rest are rate-limit fallbacks.
GEMINI_API_KEY_FOR_HYDROGEN=
GEMINI_API_KEY=
GEMINI_API_KEY2=
GEMINI_API_KEY3=

# --- OpenRouter: picture trial (ktrial run) and the Gemini fallback when free-tier keys are spent
OPENROUTER_API_KEY=

# --- OpenCode Go: picture QA panel (images.qa); QA is skipped without it ------------------------
OPENCODE_API_KEY=

# --- Optional ----------------------------------------------------------------------------------
# `novel research` (YouTube search suggestions)
YOUTUBE_API_KEY=

# Not read by the code yet (kept so nothing is lost when moving an old .env):
# FAL_KEY=
# Cloudflare named tunnel for the Kaggle image server. The token itself goes to the Kaggle dataset
# `cloudflare-tunnel` (file CLOUDFLARE_TUNNEL_TOKEN); the hostname is the setting images.cf_hostname.
# TunnelID=
# TunnelToken=
# TunnelURL=
# TunnelIDAlt=
# TunnelTokenAlt=
# TunnelURLAlt=
